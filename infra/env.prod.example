# Production env → /opt/app/.env on the server (chmod 600, owner deploy). Never commit the real file.
# Read by infra/compose.prod.yml (interpolation + the web/migrate env_file). See docs/deploy.md.
# Generate secrets:  openssl rand -base64 32  (BETTER_AUTH_SECRET, ENCRYPTION_KEY)
#                    openssl rand -hex 32     (INNGEST_EVENT_KEY, INNGEST_SIGNING_KEY — hex!)
#                    openssl rand -hex 24     (POSTGRES_PASSWORD — URL-safe)

# --- infra (compose.prod.yml) -----------------------------------------------
DOMAIN=review.example.com            # `localhost` for a local test (Caddy internal CA)
POSTGRES_PASSWORD=
# HTTP_PORT=80
# HTTPS_PORT=443
# INNGEST_DASHBOARD_PORT=8288        # host loopback only

# --- app (all vars from .env.example) ----------------------------------------
PUBLIC_URL=https://review.example.com
# DATABASE_URL, REDIS_URL, INNGEST_BASE_URL and INNGEST_DEV are set by compose.prod.yml
# (postgres/redis/inngest service addresses); values here are ignored.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://review.example.com
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=              # the PEM on one line with \n escapes, in double quotes
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
# PLATFORM_MODEL=
# PLATFORM_EFFORT=
# OPENAI_MODEL=
# CHATGPT_MODEL=
