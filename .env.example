# Copy to .env at the repo root: `cp .env.example .env`
# apps/web, packages/db (Prisma) and docker compose all read this one file.

PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=            # GitHub App's OAuth client, used by Better Auth for login
GITHUB_CLIENT_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=http://localhost:8288   # http://inngest:8288 in production compose
INNGEST_DEV=1                # dev only
INNGEST_SERVE_HOST=http://host.docker.internal:3000   # dev: the URL the Inngest container uses to call `pnpm dev` on the host (unset in production compose)
ENCRYPTION_KEY=              # 32 bytes, base64 — openssl rand -base64 32
ANTHROPIC_API_KEY=           # platform default provider
OPENAI_API_KEY=              # optional platform fallback
CHATGPT_OAUTH_CLIENT_ID=     # Sign in with ChatGPT
CHATGPT_OAUTH_CLIENT_SECRET=
# Optional model overrides (unset = defaults in @app/providers; repo settings.model wins over these)
PLATFORM_MODEL=              # default claude-opus-5-5
PLATFORM_EFFORT=             # low|medium|high|xhigh|max, default medium
OPENAI_MODEL=                # platform fallback, default gpt-5
CHATGPT_MODEL=               # codex_chatgpt, default gpt-5-codex

# Optional: host ports for docker-compose.dev.yml if 5432/6379/8288 are taken.
# Keep DATABASE_URL / REDIS_URL / INNGEST_BASE_URL in sync with them.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# INNGEST_PORT=8288
